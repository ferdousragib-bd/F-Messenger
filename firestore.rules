rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isFollower(authorId) {
      return signedIn() && exists(/databases/$(database)/documents/follows/$(authorId)/followers/$(request.auth.uid));
    }
    function canReadPost(postId) {
      let post = get(/databases/$(database)/documents/posts/$(postId)).data;
      return signedIn() && (post.visibility == 'public'
        || post.authorId == request.auth.uid
        || (post.visibility == 'followers' && isFollower(post.authorId)));
    }
    function chatMember(chatId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }
    // Private contact information is owner-only.
    match /users/{userId} {
      allow create, read, delete: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens', 'phone', 'phoneDigits', 'email', 'createdAt'])
        && (!('fcmTokens' in request.resource.data) || request.resource.data.fcmTokens is list);
      match /following/{targetUid} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, delete: if signedIn() && request.auth.uid == userId && targetUid != userId;
        allow update: if false;
      }
    }
    // Public discovery data must never contain email or private phone numbers.
    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'name', 'username', 'usernameLower', 'createdAt']);
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'username', 'usernameLower']);
      allow delete: if signedIn() && request.auth.uid == userId;
    }
    match /posts/{postId} {
      allow read: if signedIn() && (resource.data.visibility == 'public'
        || resource.data.authorId == request.auth.uid
        || (resource.data.visibility == 'followers' && isFollower(resource.data.authorId)));
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid
        && request.resource.data.caption is string && request.resource.data.caption.size() <= 5000
        && request.resource.data.visibility in ['public', 'followers', 'private']
        && request.resource.data.mediaType in ['text', 'image', 'video'];
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
      match /likes/{userId} {
        allow read: if canReadPost(postId);
        allow create: if canReadPost(postId) && request.auth.uid == userId && request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }
      match /comments/{commentId} {
        allow read: if canReadPost(postId);
        allow create: if canReadPost(postId) && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }
    match /follows/{targetUid}/followers/{followerUid} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && request.auth.uid == followerUid && targetUid != followerUid;
      allow update: if false;
    }
    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recipientId is string;
    }
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetId is string && request.resource.data.targetId != request.auth.uid
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.status == 'open';
      allow read, update, delete: if isAdmin();
    }
    match /blocks/{userId}/blocked/{blockedUid} {
      allow read, create, delete: if signedIn() && request.auth.uid == userId && blockedUid != userId;
      allow update: if false;
    }
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] is string && request.resource.data.members[1] is string
        && request.resource.data.members[0] != request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'lastMessage', 'updatedAt'])
        && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 5000;
      match /messages/{messageId} {
        allow read: if chatMember(chatId);
        allow create: if chatMember(chatId) && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 5000;
        allow update, delete: if false;
      }
    }

    // WebRTC call signaling. Only the two participants can read or change a call.
    match /calls/{callId} {
      allow create: if signedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.status == 'ringing'
        && request.resource.data.type in ['audio', 'video'];
      allow read: if signedIn()
        && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);
      allow update: if signedIn()
        && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid)
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offer', 'answer', 'status']);
      allow delete: if signedIn() && resource.data.callerId == request.auth.uid;
      match /{candidateCollection}/{candidateId} {
        allow read, create: if signedIn()
          && candidateCollection in ['callerCandidates', 'calleeCandidates']
          && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
            || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
        allow update, delete: if false;
      }
    }
  }
}