rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isFollower(authorId) {
      return signedIn() && exists(
        /databases/$(database)/documents/follows/$(authorId)/followers/$(request.auth.uid)
      );
    }
    function chatMember(chatId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn();
      allow update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /posts/{postId} {
      allow read: if signedIn()
        && (resource.data.visibility == 'public'
          || resource.data.authorId == request.auth.uid
          || (resource.data.visibility == 'followers' && isFollower(resource.data.authorId)));
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 5000
        && request.resource.data.visibility in ['public', 'followers', 'private']
        && request.resource.data.mediaType in ['text', 'image', 'video'];
      allow update, delete: if signedIn()
        && resource.data.authorId == request.auth.uid;
      match /likes/{userId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if signedIn()
          && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    match /follows/{targetUid}/followers/{followerUid} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && request.auth.uid == followerUid
        && targetUid != followerUid;
      allow update: if false;
    }
    match /users/{userId}/following/{targetUid} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && request.auth.uid == userId
        && targetUid != userId;
      allow update: if false;
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn()
        && resource.data.recipientId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recipientId is string;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 1000;
      allow read, update, delete: if isAdmin();
    }

    match /blocks/{userId}/blocked/{blockedUid} {
      allow read, create, delete: if signedIn() && request.auth.uid == userId
        && blockedUid != userId;
      allow update: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create, update: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;
      match /messages/{messageId} {
        allow read: if chatMember(chatId);
        allow create: if chatMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000;
        allow update, delete: if false;
      }
    }
  }
}