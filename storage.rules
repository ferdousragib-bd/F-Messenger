rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function chatMember(chatId) {
      return signedIn()
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/chats/$(chatId)
        ).data.members;
    }

    match /post-media/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId
        && request.resource != null
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*');
    }

    match /profile-media/{userId}/{fileName} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        firestore.get(/databases/(default)/documents/publicProfiles/$(userId)).data.profileVisibility != 'private' ||
        firestore.exists(/databases/(default)/documents/follows/$(userId)/followers/$(request.auth.uid))
      );
      allow write: if signedIn() && request.auth.uid == userId
        && request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /chat-media/{chatId}/{fileName} {
      allow read: if chatMember(chatId);
      allow write: if chatMember(chatId)
        && request.resource != null
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*|audio/.*');
    }
  }
}